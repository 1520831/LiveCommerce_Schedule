{
  "_설명": [
    "고정PGM 자동 판정의 보정 목록이다. scrapers/fixed_pgm.py 가 읽는다.",
    "",
    "auto    : 채널별 자동 판정 스위치.",
    "          CJ·HD 는 pgm 이 프로그램 이름이라 자동으로 잘 잡힌다.",
    "          KA·GM·NV 는 pgm 이 회차별 방송 제목이라 프로그램 개념이 없다.",
    "          켜면 '한 판매자가 매일 같은 제목으로 돌리는 상시 방송' 이",
    "          고정PGM 으로 잡혀 화면을 어지럽힌다. 그래서 꺼 둔다.",
    "          그 채널들은 아래 include 로 직접 등록하는 편이 정확하다.",
    "",
    "exclude : 자동으로 잡혔지만 고정PGM 이 아닌 것. {ch, pgm}",
    "          pgm 은 재방 표시와 스튜디오를 뗀 이름으로 적는다.",
    "          예) '[재방] 투명쇼 (패션잡화)' -> '투명쇼'",
    "",
    "include : 사람이 직접 등록하는 고정PGM. {ch, pgm, start, days}",
    "          days 를 빼면 매일로 본다. 같은 (ch,pgm,start) 가 자동으로도",
    "          잡혀 있으면 days 만 갈아끼운다 - 자동이 놓친 요일을 채우는 용도."
  ],

  "auto": {
    "HD": true,
    "CJ": true,
    "KA": false,
    "GM": false,
    "NV": false
  },

  "exclude": [
    {
      "ch": "CJ",
      "pgm": "라이브쇼",
      "why": "프로그램 이름이 아니라 이름 없는 슬롯의 기본값이다. 채널 이름 자체가 'CJ온스타일 라이브쇼' 다. 79회로 최다 등장이라 켜 두면 표를 덮는다."
    },
    {
      "ch": "HD",
      "pgm": "편성기획 삽입용",
      "why": "프로그램이 아니라 편성 자리를 잡아두는 표시다."
    }
  ],

  "include": [
    { "ch": "HD", "pgm": "백화점 프리오픈쇼", "start": "08:00", "days": ["월", "화", "수", "목", "금", "토", "일"] },
    { "ch": "HD", "pgm": "백화점 프리오픈쇼", "start": "09:00", "days": ["월", "화", "수", "목", "금", "토", "일"] },
    { "ch": "HD", "pgm": "투명쇼",           "start": "10:00", "days": ["월", "화", "수", "목", "금"] },
    { "ch": "HD", "pgm": "노블리타",          "start": "11:00", "days": ["월"] },
    { "ch": "HD", "pgm": "육아일기",          "start": "11:00", "days": ["화"] },
    { "ch": "HD", "pgm": "맛춤가게",          "start": "12:00", "days": ["수"] },
    { "ch": "HD", "pgm": "현대쇼룸",          "start": "19:00", "days": ["수", "일"] },
    { "ch": "HD", "pgm": "현명쇼",           "start": "20:00", "days": ["월"] },
    { "ch": "HD", "pgm": "초밀착뷰티쇼",       "start": "20:00", "days": ["수"] },
    { "ch": "HD", "pgm": "현명쇼",           "start": "21:00", "days": ["수"] },
    { "ch": "HD", "pgm": "현대렐라쇼",         "start": "23:00", "days": ["월", "화", "수", "목", "금", "토", "일"] }
  ]
}
